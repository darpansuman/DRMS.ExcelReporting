<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>DRMS.ExcelReporting</RootNamespace>
    <Description>Configuration-driven Excel report generator. Columns, data types, sheets and line breaks are defined in appsettings.json.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- ClosedXML: MIT licensed library used to write .xlsx files. -->
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DRMS.ExcelReporting.Tests" />
  </ItemGroup>

</Project>
