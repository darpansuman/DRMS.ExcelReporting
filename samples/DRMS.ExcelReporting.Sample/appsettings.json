{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },

  // ---------------------------------------------------------------------------------------
  // Excel report settings. Read by DRMS.ExcelReporting.ExcelReportGenerator.
  // Every setting is optional unless marked "required". See README.md for the full list.
  // ---------------------------------------------------------------------------------------
  "ExcelReporting": {

    // Settings shared by all reports.
    "Defaults": {
      "Culture": "en-US",               // Used to read numbers/dates that arrive as text.
      "AutoFitColumns": true,           // Fit column width to content...
      "MaxColumnWidth": 50,             // ...but never wider than this.
      "FreezeHeaderRow": true,          // Header stays visible when scrolling.
      "AutoFilter": true,               // Filter drop-downs on the header row.
      "MaxRowsPerSheet": 1048575,       // More rows continue on "Sheet (2)", "Sheet (3)", ...

      // Default Excel number formats per data type (Excel format codes).
      "Formats": {
        "Integer": "0",
        "Number": "#,##0.00",
        "Currency": "#,##0.00",
        "Percentage": "0.00%",
        "Date": "yyyy-mm-dd",
        "DateTime": "yyyy-mm-dd hh:mm:ss",
        "Time": "hh:mm"
      },

      "HeaderStyle": {
        "Bold": true,
        "BackgroundColor": "#1F4E78",
        "FontColor": "#FFFFFF",
        "WrapText": true
      },

      // Line break rules. Real line breaks (\r\n, \n) are always kept.
      "LineBreaks": {
        "Separators": [ "|", "<br>" ],   // These markers in the data become new lines.
        "CollectionSeparator": "\n",     // Lists (e.g. List<string>) get one item per line.
        "WrapTextWhenLineBreakFound": true
      }
    },

    // One entry per Excel file. The key ("EmployeeReport") is the name you pass to Generate().
    "Reports": {

      "EmployeeReport": {
        "FileName": "EmployeeReport.xlsx",
        "Sheets": [
          {
            "Name": "Employees",            // Required. Tab name, max 31 characters.
            "DataSource": "Employees",      // Key used in ExcelReportData.Add("Employees", list).
            "Title": "Employee Details",    // Optional title row above the header.
            "Columns": [
              { "Header": "Id",              "Property": "Id",             "DataType": "Integer", "Alignment": "Center" },
              { "Header": "Employee\nCode",  "Property": "EmployeeCode",   "DataType": "Text" },
              { "Header": "Full Name",       "Property": "FullName",       "DataType": "Text" },
              { "Header": "Email",           "Property": "Email",          "DataType": "Hyperlink" },
              { "Header": "Street",          "Property": "Address.Street", "DataType": "Text" },
              { "Header": "City",            "Property": "Address.City",   "DataType": "Text", "DefaultValue": "Unknown" },
              { "Header": "Joining Date",    "Property": "JoiningDate",    "DataType": "Date", "Format": "dd-mmm-yyyy" },
              { "Header": "Last Login",      "Property": "LastLogin",      "DataType": "DateTime", "DefaultValue": "Never" },
              { "Header": "Shift Start",     "Property": "ShiftStart",     "DataType": "Time" },
              { "Header": "Salary",          "Property": "Salary",         "DataType": "Currency", "Format": "\"$\"#,##0.00" },
              { "Header": "Bonus %",         "Property": "BonusRate",      "DataType": "Percentage" },
              {
                "Header": "Active",
                "Property": "IsActive",
                "DataType": "Text",
                "Alignment": "Center",
                "ValueMappings": { "True": "Yes", "False": "No" }
              },
              {
                "Header": "Status",
                "Property": "StatusCode",
                "DataType": "Text",
                "ValueMappings": { "A": "Active", "I": "Inactive", "L": "On Leave", "": "Not Set" }
              },
              { "Header": "Employment Type", "Property": "EmploymentType", "DataType": "Text" },
              { "Header": "Skills",          "Property": "Skills",         "DataType": "Text", "Width": 25 },
              {
                "Header": "Notes",
                "Property": "Notes",
                "DataType": "Text",
                "Width": 45,
                "WrapText": true,
                // Column-level line break rules replace the defaults for this column only.
                "LineBreaks": { "Separators": [ "|", "\\n" ] }
              }
            ]
          },
          {
            // Same DTO type, different list and fewer columns.
            "Name": "Active Employees",
            "DataSource": "ActiveEmployees",
            "Columns": [
              { "Header": "Full Name", "Property": "FullName" },
              { "Header": "City",      "Property": "Address.City" },
              { "Header": "Salary",    "Property": "Salary", "DataType": "Currency" }
            ]
          },
          {
            // A different DTO type on its own sheet. DataSource is empty, so the sheet name is used as the key.
            "Name": "Departments",
            "AutoFilter": false,
            "Columns": [
              { "Header": "Code",       "Property": "Code" },
              { "Header": "Department", "Property": "Name" },
              { "Header": "Manager",    "Property": "Manager" },
              { "Header": "Head Count", "Property": "HeadCount", "DataType": "Integer" },
              { "Header": "Budget",     "Property": "Budget",    "DataType": "Currency", "Format": "#,##0" },
              {
                "Header": "Locations",
                "Property": "Locations",
                "DataType": "Text",
                "LineBreaks": { "Separators": [ ";" ] }
              }
            ]
          }
        ]
      },

      // A small report where every sheet uses the same list: generator.Generate("ContactList", employees).
      "ContactList": {
        "FileName": "Contacts.xlsx",
        "Sheets": [
          {
            "Name": "Contacts",
            "Columns": [
              { "Header": "Name",  "Property": "FullName" },
              { "Header": "Email", "Property": "Email", "DataType": "Hyperlink" },
              { "Header": "City",  "Property": "Address.City" }
            ]
          }
        ]
      }
    }
  }
}
